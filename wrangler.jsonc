{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "xezrio-com",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "xezrio-com"
    }
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "xezriocom-opennext-cache"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "xezrio-auth",
      // Replace this after running: npx wrangler d1 create xezrio-auth
      "database_id": "e1f2a687-8e4e-4ae5-a488-6d1677be14fb",
      "migrations_dir": "db/migrations"
    }
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://xezrio.com"
  },
  "observability": {
    "enabled": true
  }
}
